#!/data/data/com.termux/files/usr/bin/bash

# 检查 curl 是否安装，未安装则尝试安装
if ! command -v curl >/dev/null 2>&1; then
    echo "检测到 curl 未安装，开始安装..."
    pkg install -y curl
    if [ $? -ne 0 ]; then
        echo "curl 安装失败，请手动执行 'pkg install -y curl' 后重试"
        exit 1
    fi
fi

# 定义要下载的文件 Raw 链接，需确保替换为正确可访问的链接
FILE_X_RAW_URL="https://raw.githubusercontent.com/luzihao0114/-/main/%E7%A1%95%E9%A3%8E.x"
FILE_XC_RAW_URL="https://raw.githubusercontent.com/luzihao0114/-/main/%E7%A1%95%E9%A3%8E.x.c"

# 创建临时目录
TEMP_DIR=$(mktemp -d)
if [ $? -ne 0 ]; then
    echo "创建临时目录失败"
    exit 1
fi
echo "已创建临时目录：$TEMP_DIR"

# 下载硕风.x 文件
echo "开始下载 硕风.x 文件，链接：$FILE_X_RAW_URL"
curl -sSL "$FILE_X_RAW_URL" -o "$TEMP_DIR/硕风.x"
if [ $? -ne 0 ]; then
    echo "硕风.x 文件下载失败"
    rm -rf "$TEMP_DIR"
    exit 1
fi
echo "硕风.x 文件下载成功"

# 下载硕风.x.c 文件
echo "开始下载 硕风.x.c 文件，链接：$FILE_XC_RAW_URL"
curl -sSL "$FILE_XC_RAW_URL" -o "$TEMP_DIR/硕风.x.c"
if [ $? -ne 0 ]; then
    echo "警告：硕风.x.c 文件下载失败，继续执行主程序"
fi

# 赋予硕风.x 执行权限
chmod +x "$TEMP_DIR/硕风.x"
if [ $? -ne 0 ]; then
    echo "赋予硕风.x 执行权限失败"
    rm -rf "$TEMP_DIR"
    exit 1
fi
echo "已赋予硕风.x 执行权限"

# 执行硕风.x 程序
echo "开始执行 硕风.x 程序"
"$TEMP_DIR/硕风.x"
EXEC_RESULT=$?

# 根据执行结果提示
if [ $EXEC_RESULT -eq 0 ]; then
    echo "硕风.x 程序执行成功"
else
    echo "硕风.x 程序执行失败，退出码：$EXEC_RESULT"
fi

# 清理临时目录
echo "开始清理临时目录"
rm -rf "$TEMP_DIR"
if [ $? -ne 0 ]; then
    echo "警告：临时目录清理失败，可手动删除 $TEMP_DIR"
fi
echo "脚本执行完毕"
