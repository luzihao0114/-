#!/data/data/com.termux/files/usr/bin/bash

# 检查 curl 是否安装，未安装则尝试安装
if ! command -v curl >/dev/null 2>&1; then
    echo "检测到 curl 未安装，开始安装..."
    pkg install -y curl
    if [ $? -ne 0 ]; then
        echo "curl 安装失败，请手动执行 'pkg install -y curl' 后重试"
        exit 1
    fi
fi

# 自动识别设备架构（适配所有安卓手机）
ARCH=$(uname -m)
echo "检测到设备架构：$ARCH"

# 根据架构选择对应 shc 加密的二进制文件链接（需提前为不同架构编译并上传）
case "$ARCH" in
    aarch64)  # 主流安卓手机（ARM64）
        FILE_X_RAW_URL="https://raw.githubusercontent.com/luzihao0114/-/main/硕风.x"
        ;;
    armv7l)   # 旧款安卓手机（ARM32）
        FILE_X_RAW_URL="https://raw.githubusercontent.com/luzihao0114/-/main/硕风_armv7.x"
        ;;
    *)        # 未适配架构
        echo "错误：不支持的架构 $ARCH，请联系开发者适配"
        exit 1
        ;;
esac

# 依赖文件链接（shc 生成的 .x.c 文件，非必须）
FILE_XC_RAW_URL="https://raw.githubusercontent.com/luzihao0114/-/main/%E7%A1%95%E9%A3%8E.x.c"

# 创建临时目录
TEMP_DIR=$(mktemp -d)
if [ $? -ne 0 ]; then
    echo "创建临时目录失败"
    exit 1
fi
echo "已创建临时目录：$TEMP_DIR"

# 下载对应架构的 shc 加密主程序
echo "开始下载 硕风.x 文件（架构：$ARCH），链接：$FILE_X_RAW_URL"
curl -sSL "$FILE_X_RAW_URL" -o "$TEMP_DIR/硕风.x"
if [ $? -ne 0 ]; then
    echo "硕风.x 文件下载失败"
    rm -rf "$TEMP_DIR"
    exit 1
fi
echo "硕风.x 文件下载成功"

# 下载依赖文件（非必须，失败不影响主程序）
echo "开始下载 硕风.x.c 文件，链接：$FILE_XC_RAW_URL"
curl -sSL "$FILE_XC_RAW_URL" -o "$TEMP_DIR/硕风.x.c"
if [ $? -ne 0 ]; then
    echo "警告：硕风.x.c 文件下载失败，继续执行主程序"
fi

# 赋予 shc 加密文件执行权限（直接运行无需解密）
chmod +x "$TEMP_DIR/硕风.x"
if [ $? -ne 0 ]; then
    echo "赋予硕风.x 执行权限失败"
    rm -rf "$TEMP_DIR"
    exit 1
fi
echo "已赋予硕风.x 执行权限"

# 执行 shc 加密后的主程序
echo "开始执行 硕风.x 程序"
"$TEMP_DIR/硕风.x"
EXEC_RESULT=$?

# 根据执行结果提示
if [ $EXEC_RESULT -eq 0 ]; then
    echo "硕风.x 程序执行成功"
else
    echo "硕风.x 程序执行失败，退出码：$EXEC_RESULT"
fi

# 清理临时目录
echo "开始清理临时目录"
rm -rf "$TEMP_DIR"
if [ $? -ne 0 ]; then
    echo "警告：临时目录清理失败，可手动删除 $TEMP_DIR"
fi
echo "脚本执行完毕"
